rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParticipant(chatUsers) {
      return isSignedIn() && request.auth.uid in chatUsers;
    }

    // --- USERS ---
    // Anyone signed in can read user profiles (needed for the users list,
    // search, avatars, and online status). Users can only write their own doc.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      // --- PUSH TOKENS (subcollection) ---
      // One doc per device (keyed by a locally-generated device id, not the
      // token itself). Only the owning user can read/write their own
      // devices; actually sending pushes happens server-side (Admin SDK),
      // which bypasses these rules entirely.
      match /pushTokens/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- CHATS ---
    // Only the two participants of a chat can read/write it.
    match /chats/{chatId} {
      allow read: if isParticipant(resource.data.users);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2;
      allow update: if isParticipant(resource.data.users);
      allow delete: if false;

      // --- MESSAGES (subcollection) ---
      // Only participants of the parent chat can read/write messages.
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;

        allow create: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users
                      && request.resource.data.senderId == request.auth.uid;

        // Allow the recipient to mark messages as seen (not the sender)
        allow update: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;

        allow delete: if false;
      }
    }

    // --- CALLS ---
    // A call document is the signaling channel for one audio/video call. Only
    // the caller and callee can see or change it.
    match /calls/{callId} {
      function callParty() {
        return isSignedIn() &&
          (request.auth.uid == resource.data.callerId ||
           request.auth.uid == resource.data.calleeId);
      }

      allow read: if callParty();
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.callerId
                    && request.resource.data.callerId != request.resource.data.calleeId
                    && request.resource.data.status == 'ringing';
      allow update: if callParty();
      allow delete: if false;
    }
  }
}
